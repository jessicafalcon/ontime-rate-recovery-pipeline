# Phase 8b test-int-airflow secret canary (planted then removed; ignored so an
# aborted run leaves no untracked key-shaped file — round 4 #5)
*otr-canary*

# Claude Code config is local-only: a tracked settings/.mcp.json would auto-run
# an inbound branch's hooks or MCP servers for anyone opening it (CLAUDE.md
# § Project tooling; Phase 9a Amendment M). settings.local.json is rule 5 above;
# the lock/state files carry a session id and pid.
.claude/settings.json
.mcp.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
