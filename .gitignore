# Data & secrets — never commit
data/
.claude/settings.local.json
*.duckdb
*.duckdb.wal
# secrets:begin — ONE set, equal (bare here, `**/`-anchored in .dockerignore),
# pinned by tests/test_infra.py::test_gitignore_and_dockerignore_secret_globs_agree
.env
.env.*
.envrc
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
*.pem
*.p12
*.pfx
*.key
*.p8
*-key.json
*-credentials.json
credentials*
service-account*.json
# secrets:end
!*.tfvars.example

# dbt
target/
dbt_packages/
logs/
.user.yml

# Terraform (state and tfvars are in the secrets block above)
.terraform/
crash.log

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Phase 8b test-int-airflow secret canary (planted then removed; ignored so an
# aborted run leaves no untracked key-shaped file — round 4 #5)
*otr-canary*

# Claude Code config is local-only: a tracked settings/.mcp.json would auto-run
# an inbound branch's hooks or MCP servers for anyone opening it (CLAUDE.md
# § Project tooling; Phase 9a Amendment M). settings.local.json is rule 5 above;
# the lock/state files carry a session id and pid.
.claude/settings.json
.mcp.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
