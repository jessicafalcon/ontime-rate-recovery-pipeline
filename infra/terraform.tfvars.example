# Copy to terraform.tfvars (gitignored) and set your project. `project_id` is the
# only required value; every other input has a default. Never commit
# terraform.tfvars (or any *.tfvars.json / *.auto.tfvars* — all gitignored).
project_id = "your-gcp-project-id"

# CI auth by Workload Identity Federation (no key) is OPT-IN: a default apply
# builds no WIF trust. To enable it, flip the toggle AND set your own repo/ref
# (the defaults name this repo).
# enable_ci_wif     = true
# github_repository = "your-org/your-repo"
# github_ref        = "refs/heads/main"

# region                      = "us-central1"
# enable_composer             = false
# enable_spanner              = false
# budget_alert_thresholds_usd = [50, 150]
