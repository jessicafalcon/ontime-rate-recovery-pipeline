# Copy to terraform.tfvars (gitignored) and set your project. `project_id` is the
# only required value; every other input has a default. A FORK must also set
# github_repository (its own owner/repo) so WIF trusts its CI, not this repo's.
# Never commit terraform.tfvars.
project_id = "your-gcp-project-id"

# A fork's own repo/ref for Workload Identity Federation (CI auth, no key):
# github_repository = "your-org/your-repo"
# github_ref        = "refs/heads/main"

# region                      = "us-central1"
# enable_composer             = false
# enable_spanner              = false
# budget_alert_thresholds_usd = [50, 150]
